    "id": "ethiopia-001",
    "dishName": "Doro Wat",
    "summary": "El plato nacional de Etiopía: un guiso picante de pollo cocinado lentamente con berbere, una mezcla de especias única.",
    "placeId": "Etiopía",
    "ingredients": [
      {
        "ingredient": "1 pollo entero cortado en piezas"
      },
      {
        "ingredient": "4 cebollas grandes picadas"
      },
      {
        "ingredient": "4 cucharadas de berbere (mezcla de especias)"
      },
      {
        "ingredient": "4 dientes de ajo"
      },
      {
        "ingredient": "Jengibre fresco rallado"
      },
      {
        "ingredient": "Mantequilla clarificada (niter kibbeh)"
      },
      {
        "ingredient": "6 huevos duros"
      },
      {
        "ingredient": "Caldo de pollo"
      },
      {
        "ingredient": "Sal al gusto"
      }
    ],
    "steps": [
      {
        "step": "Cocinar las cebollas a fuego lento sin aceite hasta que se sequen y caramelicen.",
        "number": 1
      },
      {
        "step": "Agregar mantequilla clarificada y cocinar hasta dorar.",
        "number": 2
      },
      {
        "step": "Añadir berbere, ajo y jengibre. Cocinar 5 minutos.",
        "number": 3
      },
      {
        "step": "Incorporar el pollo y sellar por todos lados.",
        "number": 4
      },
      {
        "step": "Agregar caldo suficiente para cubrir y cocinar a fuego lento 1 hora.",
        "number": 5
      },
      {
        "step": "Añadir los huevos duros pelados los últimos 15 minutos.",
        "number": 6
      },
      {
        "step": "Servir caliente sobre injera.",
        "number": 7
      }
    ],
